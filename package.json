{
  "name": "batchclip",
  "version": "0.1.1",
  "description": "Long-form video to AI-scored 9:16 vertical clips with PRESTYJ-style captions",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-remotion-bundle.mjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run audit:third-party -- --release && npm run build && electron-builder --dir",
    "build:win": "npm run release:win",
    "release:win": "bash scripts/release-windows.sh",
    "build:mac": "npm run release:mac",
    "release:mac": "bash scripts/release-macos.sh",
    "build:linux": "npm run audit:third-party -- --release && npm run build && electron-builder --linux",
    "test": "vitest run --config vitest.config.main.ts && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.main.ts",
    "test:main": "vitest run --config vitest.config.main.ts",
    "test:renderer": "vitest run --config vitest.config.ts",
    "eval:planner": "node scripts/planner-eval/run.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "shellcheck": "shellcheck scripts/*.sh scripts/**/*.sh",
    "verify": "npm run check && npm run typecheck && npm test",
    "audit:third-party": "node scripts/audit-third-party-assets.mjs",
    "setup:python": "bash scripts/setup-python.sh",
    "verify:blocks": "bash scripts/verify-blocks/run.sh",
    "verify:captions": "bash scripts/verify-caption-stability/run.sh",
    "verify:longform-render": "bash scripts/verify-longform-render/run.sh",
    "deploy": "bash scripts/deploy-windows.sh",
    "deploy:fast": "bash scripts/deploy-windows.sh --fast --yes",
    "deploy:mac": "bash scripts/deploy-mac.sh",
    "deploy:mac:fast": "bash scripts/deploy-mac.sh --fast --yes"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource/inter": "^5.2.8",
    "@google/genai": "^1.49.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/renderer": "4.0.496",
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.0.0",
    "immer": "^11.1.4",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.496",
    "sonner": "^2.0.7",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.496",
    "@remotion/captions": "4.0.496",
    "@remotion/cli": "4.0.496",
    "@remotion/tailwind": "4.0.496",
    "@remotion/three": "4.0.496",
    "@remotion/transitions": "4.0.496",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.186.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.batchclip.app",
    "productName": "BatchClip",
    "artifactName": "BatchClip-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/electron-builder-license-gate.mjs",
    "forceCodeSigning": false,
    "electronUpdaterCompatibility": ">=2.16",
    "generateUpdatesFilesForAllChannels": true,
    "publish": {
      "provider": "github",
      "owner": "Gahroot",
      "repo": "cliporous",
      "releaseType": "release"
    },
    "fileAssociations": [
      {
        "ext": "batchclip",
        "name": "BatchClip Project",
        "description": "BatchClip creator project",
        "mimeType": "application/x-batchclip",
        "role": "Editor"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@ffprobe-installer/**",
      "node_modules/@remotion/compositor-*/**"
    ],
    "extraResources": [
      {
        "from": "out/remotion",
        "to": "remotion",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/fonts",
        "to": "fonts",
        "filter": [
          "**/*.ttf"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "requirements.txt",
          "pyproject.toml"
        ]
      },
      {
        "from": "resources/sfx",
        "to": "sfx",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/music",
        "to": "music",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/remotion/**/*",
      "package.json",
      {
        "from": "src/main/hyperframes/catalog",
        "to": "out/main/catalog",
        "filter": [
          "**/*"
        ]
      },
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "createDesktopShortcut": "always"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "notarize": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "sign": false,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 255,
          "type": "file"
        },
        {
          "x": 410,
          "y": 255,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "overrides": {
    "@radix-ui/react-presence": "npm:@radix-ui/react-presence@1.1.5-rc.1761760880074"
  }
}
