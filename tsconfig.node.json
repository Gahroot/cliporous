{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./out",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "files": [
    "src/main/remotion/compositions/blocks/types.ts",
    "src/main/remotion/compositions/explainer/types.ts",
    "src/main/remotion/compositions/explainer/mechanisms/composed-types.ts",
    "src/main/remotion/compositions/explainer/technology/types.ts",
    "src/main/remotion/compositions/explainer/spatial/types.ts",
    "src/main/remotion/compositions/explainer/cognition/types.ts",
    "src/main/remotion/compositions/explainer/concepts/information/types.ts",
    "src/main/remotion/compositions/explainer/concepts/inference/types.ts",
    "src/main/remotion/compositions/explainer/concepts/business-operations/types.ts",
    "src/main/remotion/compositions/explainer/concepts/business-populations/types.ts",
    "src/main/remotion/compositions/explainer/concepts/perspective/types.ts",
    "src/main/remotion/compositions/explainer/concepts/adaptive/types.ts",
    "src/main/remotion/compositions/explainer/technology/agent-workflow.ts",
    "src/main/remotion/compositions/explainer/technology/motion.ts",
    "src/main/remotion/compositions/explainer/motion-tokens.ts",
    "src/main/remotion/compositions/explainer/editorial/types.ts",
    "src/main/remotion/compositions/explainer/editorial/number-logic.ts",
    "src/main/remotion/compositions/explainer/editorial/motion.ts",
    "src/main/remotion/compositions/explainer/hero-catalog.ts",
    "src/main/remotion/compositions/explainer/quote-graphic.ts",
    "src/main/remotion/compositions/explainer/palette.ts"
  ],
  "include": ["electron-vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
  "exclude": [
    "src/main/remotion/Root.tsx",
    "src/main/remotion/index.ts",
    "src/main/remotion/compositions/**",
    "src/main/remotion/shared/**",
    "src/main/**/__tests__/**",
    "src/main/**/*.test.ts"
  ]
}
